RUNTIME_PLATFORM_URL=http://localhost:8000
RUNTIME_PLATFORM_TOKEN=local-runtime-token-change-me
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
RUNTIME_LIVEKIT_TOKEN=
LIVEKIT_ROOM_NAME=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# One ElevenLabs key serves both providers.stt and providers.tts = "elevenlabs".
# ELEVENLABS_VOICE_ID is the default voice for the tts provider.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Only needed when a session selects the gemini llm provider (providers.llm). Gemini is used
# through its OpenAI-compatible endpoint; no model is built in. Set the provider record's
# "model" or the variables below (the session refuses to start without one).
GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=
# GEMINI_MODEL=              # agent mode (conversation LLM)
# GEMINI_BASE_URL=           # default: Google's OpenAI-compatible endpoint
GOOGLE_TRANSLATE_API_KEY=    # Cloud Translation, llm provider `google-translate` (translation only)
# GOOGLE_TRANSLATE_TIMEOUT_S=2    # per-sentence deadline; past it the Gemini backup answers
# GOOGLE_TRANSLATE_BASE_URL=      # testing only: point at a fake Google to inject failures

# SIP transfer (optional): transfer_to_human for phone calls is enabled whenever
# LIVEKIT_URL/LIVEKIT_API_KEY/LIVEKIT_API_SECRET are set. The destination comes from the
# deployment's configuration.transfer_to (sent by the Platform); SIP_TRANSFER_TO is the
# fallback (E.164 or tel:/sip: URI). With neither, a SIP transfer reports transfer_not_configured.
# LIVEKIT_SIP_TRUNK_ID=
# SIP_TRANSFER_TO=

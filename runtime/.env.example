RUNTIME_PLATFORM_URL=http://localhost:8000
RUNTIME_PLATFORM_TOKEN=local-runtime-token-change-me
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
RUNTIME_LIVEKIT_TOKEN=
LIVEKIT_ROOM_NAME=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Only needed when a session selects the elevenlabs TTS provider (providers.tts).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# SIP transfer (optional): transfer_to_human for phone calls is enabled whenever
# LIVEKIT_URL/LIVEKIT_API_KEY/LIVEKIT_API_SECRET are set. The destination comes from the
# deployment's configuration.transfer_to (sent by the Platform); SIP_TRANSFER_TO is the
# fallback (E.164 or tel:/sip: URI). With neither, a SIP transfer reports transfer_not_configured.
# LIVEKIT_SIP_TRUNK_ID=
# SIP_TRANSFER_TO=

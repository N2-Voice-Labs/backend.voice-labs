# Copy to .env (git-ignored) and fill in. Compose loads it automatically.
# Everything below is optional except provider keys needed for real voice sessions.
#
# Want to use the DEPLOYED frontend with this machine? Use `.env.public.example` instead
# (cp .env.public.example .env) or see the "Public demo" block at the bottom of this file.

# --- Compose profiles ----------------------------------------------------------------------
# local-livekit = run the bundled LiveKit server (local dev). Public demo uses `tunnel`
# instead (LiveKit Cloud + Cloudflare Tunnel).
COMPOSE_PROFILES=local-livekit

# --- Shared secret between Platform and Runtime -------------------------------------------
# Becomes PLATFORM_RUNTIME_TOKEN (Platform) and RUNTIME_PLATFORM_TOKEN (Runtime). The
# default is for local use only: change it for anything reachable beyond your machine
# (e.g. `openssl rand -hex 32`).
RUNTIME_TOKEN=local-runtime-token-change-me

# --- Provider keys (leave empty to start without them) ------------------------------------
# Without them the stack starts, but voice sessions fail with 503 provider_unavailable.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
# OpenAI-compatible endpoint override and the model used for health probes (optional).
OPENAI_BASE_URL=
OPENAI_HEALTH_MODEL=

# --- Platform ------------------------------------------------------------------------------
# Comma-separated API keys. Empty = auth DISABLED (fine locally, never in production).
PLATFORM_API_KEYS=
# Browser origin(s) allowed by CORS (comma-separated) - your frontend's URL(s).
PLATFORM_WEB_ORIGIN=http://localhost:3000
PLATFORM_MAX_ACTIVE_SESSIONS_PER_ORG=10
PLATFORM_SESSION_CREATE_RATE=30/min
PLATFORM_REAPER_INTERVAL_SECS=60
PLATFORM_STALE_SESSION_SECS=900
# 1 = send a cloned voice to the provider right after POST /voices/clone (and on Retry).
# 0 = stay pending until something calls POST /voices/{id}/provision.
PLATFORM_AUTO_PROVISION_CLONES=1
# Optional: webhook notified when a provider's health changes.
PLATFORM_ALERT_WEBHOOK_URL=

# --- LiveKit -------------------------------------------------------------------------------
# Dev credentials; used by the local livekit container, Platform and Runtime alike.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# URL Platform and Runtime (inside compose) use to reach LiveKit. Default: the bundled server.
LIVEKIT_URL=ws://livekit:7880
# URL returned to browsers in session responses; clients must be able to reach it (the
# published port locally, wss://<project>.livekit.cloud with LiveKit Cloud).
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# IP advertised in WebRTC ICE candidates. 127.0.0.1 = browser on this machine. For a
# browser on another device use this host's LAN IP (and set LIVEKIT_PUBLIC_URL to match).
LIVEKIT_NODE_IP=127.0.0.1
# Outbound SIP (optional): LiveKit SIP trunk id, and fallback transfer destination.
LIVEKIT_SIP_TRUNK_ID=
SIP_TRANSFER_TO=

# --- Runtime limits (optional; empty = built-in defaults) ---------------------------------
RUNTIME_MAX_SESSIONS=
RUNTIME_MAX_SESSION_SECS=
RUNTIME_IDLE_PROMPT_SECS=
RUNTIME_IDLE_END_SECS=

# --- Host ports ----------------------------------------------------------------------------
POSTGRES_PORT=5432
PLATFORM_PORT=8300
RUNTIME_PORT=8301
LIVEKIT_PORT=7880

# --- Postgres (local-only defaults) --------------------------------------------------------
POSTGRES_DB=voice_labs
POSTGRES_USER=voice_labs
POSTGRES_PASSWORD=local-only

# =============================================================================================
# Public demo (Cloudflare Tunnel + LiveKit Cloud)
# =============================================================================================
# To let the deployed frontend (https://voice-lab.nomadic.fyi) use this machine, the
# easiest path is `cp .env.public.example .env`. Or, in THIS file, replace the matching
# settings above with the values below, then run `make public`.
# See README "Use the deployed frontend with this Mac (public demo)".
#
# Profiles: tunnel only (no local LiveKit server).
# COMPOSE_PROFILES=tunnel
# Token of the Cloudflare tunnel (Zero Trust -> Networks -> Tunnels). Secret: never commit.
# CLOUDFLARE_TUNNEL_TOKEN=
# LiveKit Cloud project (both URLs are the same wss:// URL).
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# CORS: the deployed site (comma-separated; keep localhost for local dev).
# PLATFORM_WEB_ORIGIN=https://voice-lab.nomadic.fyi,http://localhost:3000
# The API is open (the frontend sends no credentials), so cap spend:
# PLATFORM_MAX_ACTIVE_SESSIONS_PER_ORG=3    # concurrent sessions
# PLATFORM_SESSION_CREATE_RATE=10           # session creations per minute
# RUNTIME_MAX_SESSIONS=4                    # concurrent sessions in Runtime
# RUNTIME_MAX_SESSION_SECS=600              # hard length cap per session
# RUNTIME_IDLE_END_SECS=60                  # hang up after this much silence
# Also set a non-default RUNTIME_TOKEN above (openssl rand -hex 32).

# MVP deployment template; canonical instructions: docs/deploy.md
# Copy to .env locally and fill every blank required value. Never commit .env.
# Postgres: generate a password; URL-encode it in PLATFORM_DATABASE_URL.
POSTGRES_DB=voice_labs
POSTGRES_USER=voice_labs
POSTGRES_PASSWORD=
PLATFORM_DATABASE_URL=
# URL format: postgresql+psycopg://voice_labs:<encoded-password>@postgres:5432/voice_labs
# Required: generate one random token and put the SAME value in both settings.
PLATFORM_RUNTIME_TOKEN=
RUNTIME_PLATFORM_TOKEN=
# Private Compose service addresses; do not use public/tunnel URLs here.
RUNTIME_API_URL=http://runtime:8001
RUNTIME_PLATFORM_URL=http://platform:8000
# Required admin key(s), comma-separated; blank disables API authentication.
PLATFORM_API_KEYS=
# Both frontend origins, comma-separated, without paths or trailing slashes.
PLATFORM_WEB_ORIGIN=https://unai-inha-demo.workers.dev,https://unai-site.workers.dev
# Enable only behind the trusted tunnel/proxy with port 8000 loopback-bound.
PLATFORM_TRUST_PROXY=1
FORWARDED_ALLOW_IPS=*
PLATFORM_PUBLIC_CALLS=1
PLATFORM_CALLS_PROVIDERS=stt=elevenlabs,llm=google-translate,tts=elevenlabs
# Initially blank; paste the seed command's inha-admissions=<UUID> mapping here.
PLATFORM_DEMO_AGENTS=
PLATFORM_DEMO_MAX_SECONDS=300
# Required separate staff secret; enter it in the portal staff UI, never a public build var.
PLATFORM_STAFF_KEY=
PLATFORM_HANDOFF_STAFF_LANGUAGE=ko
# Translated calls: "auto" detects each sentence's language (either person may speak either language of the pair); "declared" locks each person to their own language.
PLATFORM_CALLS_SPEAKER_LANGUAGE=auto
PLATFORM_INLINE_KNOWLEDGE_MAX_CHARS=60000
# Confirm this model is available to your Gemini account before the demo.
PLATFORM_CHAT_LLM_MODEL=gemini-3.5-flash-lite
PLATFORM_MAX_ACTIVE_SESSIONS_PER_ORG=3
# Required: LiveKit Cloud project wss:// URL and server credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Required for demo speech, agent/chat, and translated human handoff respectively.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Optional chat overrides: omit to use GEMINI_API_KEY and the default Gemini endpoint.
# PLATFORM_CHAT_LLM_API_KEY=
# PLATFORM_CHAT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional Gemini model overrides; agent configuration may specify its own model.
# GEMINI_MODEL=
# GEMINI_TRANSLATION_MODEL=
# Demo limits and cleanup (all forwarded to their respective services).
PLATFORM_SESSION_CREATE_RATE=10
PLATFORM_CHAT_PER_IP_MINUTE=20
PLATFORM_CALLS_PER_IP_HOUR=10
PLATFORM_CALL_OPEN_PER_IP_MINUTE=30
PLATFORM_CALL_INVITE_TTL_SECS=1800
PLATFORM_REAPER_INTERVAL_SECS=30
PLATFORM_STALE_SESSION_SECS=900
RUNTIME_MAX_SESSIONS=4
RUNTIME_MAX_SESSION_SECS=600
RUNTIME_IDLE_PROMPT_SECS=30
RUNTIME_IDLE_END_SECS=60
# Drop transcripts that echo translated speech played in the last N seconds (feedback-loop guard); 0 turns it off.
RUNTIME_ECHO_GUARD=1
RUNTIME_ECHO_GUARD_SECS=10
# Local LiveKit only: COMPOSE_PROFILES=local-livekit and LIVEKIT_URL=ws://<Docker-host-LAN-IP>:7880.
# Use a host LAN IP reachable from both containers and browsers; edit docker/livekit.yaml
# rtc.node_ip to that IP as well.
# Use LiveKit Cloud for the HTTPS/mobile demo.
COMPOSE_PROFILES=

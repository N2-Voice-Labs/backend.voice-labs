# Deployment template; canonical instructions: docs/deploy.md
# `scripts/deploy.sh` creates .env from this file and generates the secrets for you.
# By hand: cp .env.example .env, fill every value in the REQUIRED section. Never commit .env.

########################################################################################
# REQUIRED
########################################################################################

# --- Postgres (secrets are generated by scripts/deploy.sh) -----------------------------
POSTGRES_DB=voice_labs
POSTGRES_USER=voice_labs
POSTGRES_PASSWORD=
# postgresql+psycopg://voice_labs:<URL-encoded-password>@postgres:5432/voice_labs
# (deploy.sh generates a hex password, which needs no encoding)
PLATFORM_DATABASE_URL=

# --- Platform auth ---------------------------------------------------------------------
# Admin API key(s), comma-separated. A blank value means every authenticated request is
# rejected with 401 (see PLATFORM_AUTH_DISABLED below); it does NOT disable auth.
PLATFORM_API_KEYS=
# Separate staff secret for the handoff staff UI; never a public frontend build variable.
PLATFORM_STAFF_KEY=
# One random token, the SAME value in both settings (Platform <-> Runtime).
PLATFORM_RUNTIME_TOKEN=
RUNTIME_PLATFORM_TOKEN=

# --- Frontends -------------------------------------------------------------------------
# Frontend origins allowed by CORS, comma-separated, scheme + host, no path or trailing
# slash. e.g. https://frontend-voice-labs.<subdomain>.workers.dev,https://voice-labs.<subdomain>.workers.dev
PLATFORM_WEB_ORIGIN=

# --- LiveKit Cloud (project wss:// URL and server API credentials) ----------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Providers for the default demo (PLATFORM_CALLS_PROVIDERS below) ---------------------
# ElevenLabs: speech-to-text and text-to-speech for translated calls.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Gemini: agent/chat LLM (also the default chat + embedding key).
GEMINI_API_KEY=
# Google Cloud Translation: translated calls / human handoff.
GOOGLE_TRANSLATE_API_KEY=

########################################################################################
# OPTIONAL: Cloudflare tunnel and proxy trust
########################################################################################

# Named-tunnel token from Cloudflare Zero Trust > Networks > Tunnels. With a token set,
# also set COMPOSE_PROFILES=tunnel (deploy.sh does this) to run cloudflared in compose and
# point the tunnel's public hostname at http://platform:8000. Leave both blank to run
# cloudflared on the host against http://localhost:8000 instead.
TUNNEL_TOKEN=
COMPOSE_PROFILES=

# Behind the tunnel the client IP (used by the per-IP rate limits) comes from
# X-Forwarded-For, which uvicorn honours only from trusted peers: FORWARDED_ALLOW_IPS.
# Compose pins its network to COMPOSE_SUBNET and trusts exactly that subnet. That covers
# both topologies: cloudflared in compose connects from a container IP in the subnet, and
# cloudflared on the host connects through the published port as the network gateway
# (172.29.0.1), also in the subnet. Do not use 127.0.0.1 (nothing connects from there)
# and avoid "*": it trusts the leftmost, client-controlled X-Forwarded-For entry, so rate
# limits could be dodged by spoofing. "*" is acceptable only because Platform's host port
# is bound to 127.0.0.1. If you change COMPOSE_SUBNET (e.g. it clashes), change both.
# (The old PLATFORM_TRUST_PROXY setting is retired and ignored.)
COMPOSE_SUBNET=172.29.0.0/24
FORWARDED_ALLOW_IPS=172.29.0.0/24

########################################################################################
# OPTIONAL: behaviour (defaults shown)
########################################################################################

# Private Compose service addresses; never public/tunnel URLs.
RUNTIME_API_URL=http://runtime:8001
RUNTIME_PLATFORM_URL=http://platform:8000

# Never set to 1 in production: it turns API authentication off entirely.
PLATFORM_AUTH_DISABLED=0
PLATFORM_LOG_LEVEL=INFO
# Browser-facing LiveKit URL if it differs from LIVEKIT_URL (default: LIVEKIT_URL).
# LIVEKIT_PUBLIC_URL=

# --- Public calls and the demo agent ----------------------------------------------------
PLATFORM_PUBLIC_CALLS=1
PLATFORM_CALLS_PROVIDERS=stt=elevenlabs,llm=google-translate,tts=elevenlabs
# Translated calls: "auto" detects each sentence's language (either person may speak either
# language of the pair); "declared" locks each person to their own language.
PLATFORM_CALLS_SPEAKER_LANGUAGE=auto
# Max length of a public call, in seconds.
PLATFORM_PUBLIC_CALL_MAX_SECONDS=1800
# Initially blank; paste the seed command's inha-admissions=<UUID> mapping here
# (scripts/deploy.sh prints the line after seeding).
PLATFORM_DEMO_AGENTS=
PLATFORM_DEMO_MAX_SECONDS=300
PLATFORM_HANDOFF_STAFF_LANGUAGE=ko
# PLATFORM_CALLS_ORG_ID=

# --- Demo chat ---------------------------------------------------------------------------
# Retrieval: rag (default) or inline (whole knowledge base in the prompt).
PLATFORM_CHAT_KNOWLEDGE_MODE=rag
# OpenAI-compatible embedding model; uses the chat key/base URL, 768 dimensions.
PLATFORM_EMBEDDING_MODEL=gemini-embedding-001
# Optional: embeddings use their own endpoint/key when set (e.g. when the chat LLM is the Claude demo bridge).
# PLATFORM_EMBEDDING_API_KEY=
# PLATFORM_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PLATFORM_INLINE_KNOWLEDGE_MAX_CHARS=60000
# Confirm this model is available to your Gemini account before the demo.
PLATFORM_CHAT_LLM_MODEL=gemini-3.5-flash-lite
PLATFORM_CHAT_LLM_PROVIDER=openai_compatible
PLATFORM_CHAT_LLM_MAX_TOKENS=700
PLATFORM_CHAT_LLM_TEMPERATURE=0.4
# Omit to use GEMINI_API_KEY and the default Gemini endpoint.
# PLATFORM_CHAT_LLM_API_KEY=
# PLATFORM_CHAT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Claude for chat instead of Gemini (the image already includes the anthropic package):
#   PLATFORM_CHAT_LLM_PROVIDER=anthropic, ANTHROPIC_API_KEY=..., PLATFORM_CHAT_LLM_MODEL=claude-haiku-5-5
# (raise PLATFORM_CHAT_LLM_MAX_TOKENS if replies are cut off).
# ANTHROPIC_API_KEY=
# PLATFORM_CHAT_LLM_EFFORT=low

# --- Rate limits and caps -----------------------------------------------------------------
# Demo-day values: a venue audience shares one public IP (NAT), so per-IP limits are high.
# Lower them again for ordinary operation.
PLATFORM_CALLS_PER_IP_HOUR=60
PLATFORM_CHAT_PER_IP_MINUTE=60
PLATFORM_CALL_OPEN_PER_IP_MINUTE=60
# POST /voice/sessions per API key per minute (staff/portal flows; the venue audience uses
# the public per-IP limits above, so 30 is plenty).
PLATFORM_SESSION_CREATE_RATE=30
# Outbound dials per organization per hour.
PLATFORM_DIAL_PER_ORG_HOUR=30
# Keep at or below RUNTIME_MAX_SESSIONS (one Runtime handles all calls on this host).
PLATFORM_MAX_ACTIVE_SESSIONS_PER_ORG=3
PLATFORM_CALL_INVITE_TTL_SECS=1800
PLATFORM_REAPER_INTERVAL_SECS=30
PLATFORM_STALE_SESSION_SECS=900
RUNTIME_MAX_SESSIONS=4
RUNTIME_MAX_SESSION_SECS=600
RUNTIME_IDLE_PROMPT_SECS=30
RUNTIME_IDLE_END_SECS=60
# Drop transcripts that echo translated speech played in the last N seconds (feedback-loop
# guard); RUNTIME_ECHO_GUARD=0 turns it off.
RUNTIME_ECHO_GUARD=1
RUNTIME_ECHO_GUARD_SECS=10
# Let agent HTTP tools reach private/loopback addresses. Keep 0 in production.
RUNTIME_TOOL_ALLOW_PRIVATE=0

########################################################################################
# OPTIONAL: other providers, SIP and alerting (unset = feature unavailable)
########################################################################################

# Other speech providers an agent can be configured to use.
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_HEALTH_MODEL=
# Model/endpoint overrides; an agent's own configuration may specify its model.
# GEMINI_MODEL=
# GEMINI_TRANSLATION_MODEL=
# GEMINI_BASE_URL=
# GOOGLE_TRANSLATE_BASE_URL=
# GOOGLE_TRANSLATE_TIMEOUT_S=
# GOOGLE_TRANSLATE_KEEPALIVE_S=
# Outbound phone calls through a LiveKit SIP trunk.
# LIVEKIT_SIP_TRUNK_ID=
# LIVEKIT_SIP_KRISP=0
# LIVEKIT_SIP_RINGING_TIMEOUT_S=
# Fallback call-transfer destination (E.164 or sip: URI).
# SIP_TRANSFER_TO=
# Chat/Slack-style webhook notified when a provider goes down or recovers.
# PLATFORM_ALERT_WEBHOOK_URL=

# Local LiveKit only (development): COMPOSE_PROFILES=local-livekit and
# LIVEKIT_URL=ws://<Docker-host-LAN-IP>:7880; edit docker/livekit.yaml rtc.node_ip to that
# IP too. Use LiveKit Cloud for the HTTPS/mobile demo.

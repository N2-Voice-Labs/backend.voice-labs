# Public demo: deployed frontend (Cloudflare) -> Cloudflare Tunnel -> this machine,
# media over LiveKit Cloud.   cp .env.public.example .env   then fill the values marked FILL.
# Never commit .env. See README "Use the deployed frontend with this Mac (public demo)".

COMPOSE_PROFILES=tunnel

# FILL 1: Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# FILL 2-4: LiveKit Cloud project settings (both URLs identical, wss://...livekit.cloud)
LIVEKIT_URL=wss://FILL-ME.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://FILL-ME.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# FILL 5-7: speech/LLM provider keys (required for voice sessions; ELEVENLABS is optional)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=

# FILL 8: shared Platform<->Runtime secret, e.g. `openssl rand -hex 32`
RUNTIME_TOKEN=

# CORS: only the deployed site (add ,http://localhost:3000 to also allow local dev)
PLATFORM_WEB_ORIGIN=https://voice-lab.nomadic.fyi

# Spend caps (the API is open: anyone with the URL can start calls on your keys)
PLATFORM_MAX_ACTIVE_SESSIONS_PER_ORG=3
PLATFORM_SESSION_CREATE_RATE=10
RUNTIME_MAX_SESSIONS=4
RUNTIME_MAX_SESSION_SECS=600
RUNTIME_IDLE_END_SECS=60
